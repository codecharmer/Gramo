{
  "$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/wp-env.json",
  "core": null,
  "phpVersion": "8.3",
  "plugins": [
    "./wp-content/plugins/woocommerce",
    "./wp-content/plugins/wp-graphql",
    "./wp-content/plugins/gramo-core"
  ],
  "themes": [
    "./wp-content/themes/gramo"
  ],
  "mappings": {
    "wp-content/plugins/gramo-core": "./wp-content/plugins/gramo-core",
    "wp-content/themes/gramo": "./wp-content/themes/gramo"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "echo '[gramo] wp-env is up. Activate WooCommerce, the Gramo theme and Gramo Core, then seed demo content with:  wp-env run cli wp gramo install   (see docs/setup.md).'"
  },
  "env": {
    "tests": {
      "config": {
        "WP_DEBUG": true,
        "SCRIPT_DEBUG": true
      }
    }
  }
}
